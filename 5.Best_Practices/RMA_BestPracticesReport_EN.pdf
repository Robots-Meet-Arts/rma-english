1124 0 obj
<<
/Type /StructElem
/S /H2
/P 215 0 R
/T (Strengthen teacher training in educational robotics.)
/E (Strengthen teacher training in educational robotics.)
/Pg 47 0 R
/K [4]
>>
endobj
1125 0 obj
<<
/Type /StructElem
/S /P
/P 215 0 R
/E (Teacher confidence and pedagogical understanding are essential for the successful implementation of robotics activities in schools. Training programmes should therefore focus not only on the technical use of robotics tools but also on pedagogical strategies for integrating robotics into different subjects and supporting inclusive learning environments.)
/Pg 47 0 R
/K [5]
>>
endobj
1126 0 obj
<<
/Type /StructElem
/S /P
/P 215 0 R
/E (Teacher confidence and pedagogical understanding are essential for the successful implementation of robotics activities in schools. )
/Pg 47 0 R
/K [6]
>>
endobj
1127 0 obj
<<
/Type /StructElem
